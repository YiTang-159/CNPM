# Có thể tạo .env tự động với mật khẩu ngẫu nhiên: npm run setup:local
DB_HOST=127.0.0.1
DB_PORT=1433
DB_NAME=DubchefDB
DB_USER=sa
DB_PASSWORD=CHANGE_TO_A_STRONG_UNIQUE_PASSWORD
ADMIN_EMAIL=admin@dubchef.vn
ADMIN_PASSWORD=CHANGE_TO_A_STRONG_UNIQUE_ADMIN_PASSWORD
TOKEN_SECRET=CHANGE_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# true nếu đã có database và user không có quyền tạo DB (vẫn cần quyền migrate).
DB_SKIP_CREATE=false
# Chỉ bật true để thử mô phỏng, không dùng cho thu tiền thật.
PAYMENT_DEMO=false
SERVE_WEB=false
