# Mặc định để trống: /api đi qua Vite proxy khi phát triển,
# hoặc cùng tên miền với web khi chạy Docker/production.
VITE_API_URL=
VITE_PAYMENT_API_URL=
# URL web công khai dùng tạo QR. Để trống để lấy URL hiện tại.
VITE_PUBLIC_URL=
# Không đặt mật khẩu admin, DB_PASSWORD hay TOKEN_SECRET trong biến VITE_*.
