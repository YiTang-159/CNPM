# Dubchef - public template ONLY. Do NOT use these placeholders as real credentials.
# On first local installation: npm run setup:local (writes secrets into the ignored .env).
# If SQL volume already exists, KEEP the existing DB_PASSWORD in the local .env.
DB_HOST=db
DB_PORT=1433
DB_NAME=DubchefDB
DB_USER=sa
DB_BIND_ADDRESS=127.0.0.1
API_BIND_ADDRESS=127.0.0.1
DB_TRUST_SERVER_CERTIFICATE=true
DB_PASSWORD=GENERATE_USING_NPM_RUN_SETUP_LOCAL

ADMIN_EMAIL=admin@dubchef.vn
# >=12 characters. Setup generates a unique secret; never deploy with this placeholder.
ADMIN_PASSWORD=GENERATE_USING_NPM_RUN_SETUP_LOCAL
TOKEN_SECRET=GENERATE_USING_NPM_RUN_SETUP_LOCAL
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
DB_SKIP_CREATE=false

# Exactly ONE payment mode: disabled | demo | payos. Never use demo to collect money.
PAYMENT_MODE=disabled
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=
PAYOS_CANCEL_URL=

SERVE_WEB=false
OLLAMA_MODEL=qwen2.5:3b
# optional protected monitoring endpoint, set a random >=24 character token
METRICS_TOKEN=
STATS_TZ_HOURS=7
