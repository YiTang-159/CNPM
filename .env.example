# Có thể tạo .env tự động với mật khẩu ngẫu nhiên: npm run setup:local
DB_HOST=127.0.0.1
DB_PORT=1433
DB_NAME=DubchefDB
DB_USER=sa
# Mặc định SQL Server và API chỉ mở trên máy hiện tại (SSMS localhost,1433).
DB_BIND_ADDRESS=127.0.0.1
API_BIND_ADDRESS=127.0.0.1
# Chỉ true với SQL Server Docker có chứng chỉ tự ký; khi deploy dùng CA tin cậy đặt false.
DB_TRUST_SERVER_CERTIFICATE=true
DB_PASSWORD=GENERATE_USING_NPM_RUN_SETUP_LOCAL
ADMIN_EMAIL=admin@dubchef.vn
ADMIN_PASSWORD=GENERATE_USING_NPM_RUN_SETUP_LOCAL
TOKEN_SECRET=GENERATE_USING_NPM_RUN_SETUP_LOCAL
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# true nếu đã có database và user không có quyền tạo DB (vẫn cần quyền migrate).
DB_SKIP_CREATE=false
# Chỉ bật true để thử mô phỏng, không dùng cho thu tiền thật.
# disabled (an toàn mặc định), demo (chỉ TEST), payos (thanh toán ngân hàng thật)
PAYMENT_MODE=disabled
PAYMENT_DEMO=false
# Tạo kênh thanh toán tại my.payos.vn; KHÔNG đưa khóa vào GitHub/ZIP nộp.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# URL website công khai đã deploy, chọn trang Bảng giá khi quay lại.
PAYOS_RETURN_URL=https://your-public-domain.example/#/pricing
PAYOS_CANCEL_URL=https://your-public-domain.example/#/pricing
SERVE_WEB=false
