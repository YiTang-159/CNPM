# Địa chỉ Backend (để trống = dùng dữ liệu tạm trong trình duyệt)
# Bỏ dấu # để dùng dữ liệu THẬT (tài khoản, lượt truy cập, trang Admin lấy từ SQL Server qua API).
# VITE_API_URL=http://localhost:3000

# API thanh toán (SQL Server trong Docker). Để trống = đơn hàng lưu tạm trong trình duyệt.
# VITE_PAYMENT_API_URL=http://localhost:3000

# Địa chỉ web đã đăng lên mạng, dùng để tạo mã QR cho khách (điện thoại không mở được localhost).
# Để trống = lấy địa chỉ trang đang mở. Ví dụ: https://ten-ban.github.io/CNPM/
# VITE_PUBLIC_URL=https://ten-ban.github.io/CNPM/


# Đếm lượt quét mã QR bằng Supabase (miễn phí, không cần Backend riêng). Chạy db/supabase-qr.sql trong Supabase trước.
# VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJ...
