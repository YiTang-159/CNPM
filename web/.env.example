# Public frontend settings ONLY - anything prefixed VITE_ is visible in the browser.
# NEVER put DB passwords, token signing keys or payOS API keys here.
VITE_API_URL=http://localhost:3000
VITE_PAYMENT_API_URL=http://localhost:3000
VITE_PUBLIC_URL=
# This only enables a browser-local offline mock during DEV; use backend PAYMENT_MODE=demo for Docker.
VITE_ENABLE_PAYMENT_DEMO=false

# Real public contact email (never use a reserved .example address in production)
VITE_CONTACT_EMAIL=
# Public HTTPS URL reachable from a phone; the QR is withheld until set.
VITE_PUBLIC_BASE_URL=
